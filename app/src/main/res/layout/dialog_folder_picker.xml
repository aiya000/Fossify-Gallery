<?xml version="1.0" encoding="utf-8"?>
<!-- the gallery's own folder picker, see FolderPickerDialog; laid out like commons' dialog_filepicker
     with a row of storage chips above the breadcrumbs -->
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/folder_picker_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/folder_picker_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <org.fossify.gallery.views.StorageChips
            android:id="@+id/folder_picker_storages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/medium_margin"
            android:paddingStart="@dimen/activity_margin"
            android:paddingTop="@dimen/small_margin"
            android:paddingEnd="@dimen/small_margin"
            android:paddingBottom="@dimen/small_margin" />

        <org.fossify.gallery.views.FolderPickerBreadcrumbs
            android:id="@+id/folder_picker_breadcrumbs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/folder_picker_storages"
            android:paddingStart="@dimen/activity_margin"
            android:paddingEnd="@dimen/small_margin"
            android:paddingBottom="@dimen/small_margin"
            android:visibility="gone" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/folder_picker_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/folder_picker_breadcrumbs"
            android:layout_centerHorizontal="true"
            android:alpha="0.8"
            android:gravity="center"
            android:paddingStart="@dimen/activity_margin"
            android:paddingEnd="@dimen/activity_margin"
            android:text="@string/loading"
            android:textSize="@dimen/bigger_text_size"
            android:textStyle="italic" />

        <com.qtalk.recyclerviewfastscroller.RecyclerViewFastScroller
            android:id="@+id/folder_picker_fastscroller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/folder_picker_breadcrumbs">

            <org.fossify.commons.views.MyRecyclerView
                android:id="@+id/folder_picker_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/medium_margin"
                android:layoutAnimation="@anim/layout_animation"
                android:scrollbars="none"
                app:layoutManager="org.fossify.commons.views.MyLinearLayoutManager" />

        </com.qtalk.recyclerviewfastscroller.RecyclerViewFastScroller>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/folder_picker_fabs_holder"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:orientation="vertical">

        <org.fossify.commons.views.MyFloatingActionButton
            android:id="@+id/folder_picker_fab_show_hidden"
            android:layout_width="@dimen/fab_size"
            android:layout_height="@dimen/fab_size"
            android:layout_marginEnd="@dimen/activity_margin"
            android:layout_marginBottom="@dimen/activity_margin"
            android:src="@drawable/ic_unhide_vector" />

    </LinearLayout>

    <org.fossify.commons.views.MyFloatingActionButton
        android:id="@+id/folder_picker_fab"
        android:layout_width="@dimen/fab_size"
        android:layout_height="@dimen/fab_size"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/activity_margin"
        android:src="@drawable/ic_plus_vector"
        android:visibility="gone" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
