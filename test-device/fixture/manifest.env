# What the fixture share holds, once seed-share.sh has built it.
#
# The counts are here rather than in each script because they are what the driving scripts assert
# on: the real share has around 14000 videos in 1088 folders and no number anyone could check
# against, which is half of why every verification had to be done by eye.
#
# Sourced by both the seeding and the driving scripts.
#
# The paths below are worked out from where this file sits, not from the working directory. They
# were relative to it once, and a script run from the repository root rather than from test-device/
# then pointed at a share that does not exist -- which reads as a fixture that was never seeded
FIXTURE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# where the share is built on this machine, and what the container serves it as
FIXTURE_SHARE_DIR="${FIXTURE_SHARE_DIR:-$FIXTURE_DIR/share}"
FIXTURE_SHARE_NAME="${FIXTURE_SHARE_NAME:-gallery}"

# the fixture's own credentials. They guard a directory of generated test patterns, so they are
# checked in on purpose -- nothing here is worth keeping out of the repository
FIXTURE_SMB_USER="${FIXTURE_SMB_USER:-gallery}"
FIXTURE_SMB_PASSWORD="${FIXTURE_SMB_PASSWORD:-gallery}"
FIXTURE_SMB_DOMAIN="${FIXTURE_SMB_DOMAIN:-}"

# How the app reaches the share. 10.0.2.2 is the host as seen from inside the emulator.
# The port is not 445: on a WSL host Windows is already listening there, so the container is
# published high and the app is pointed at it -- which the app allows, smbPort is a setting
FIXTURE_SMB_HOST="${FIXTURE_SMB_HOST:-10.0.2.2}"
FIXTURE_SMB_PORT="${FIXTURE_SMB_PORT:-4450}"

# the folder inside the share that "smb:/" stands for. Empty means the share's own root
FIXTURE_SMB_ROOT_PATH="${FIXTURE_SMB_ROOT_PATH:-}"

# the app under test. The debug build on purpose: it is a separate app with its own settings, so
# pointing it at the fixture cannot touch the release app's share -- and run-as works on it
FIXTURE_PACKAGE="${FIXTURE_PACKAGE:-io.github.aiya000.fossify.gallery.debug}"

# The tree seed-share.sh builds, as "<folder>:<videos>:<images>". Every folder here holds media
# directly; Trips holds nothing but the two folders under it, which is deliberate -- a folder with
# no media of its own must not turn up in the folder list
FIXTURE_TREE=(
    "Camera:3:2"
    "Trips/Kyoto:2:0"
    "Trips/Osaka:2:0"
    "Screens:0:2"
)

# A folder of large files, as "<name>:<pixels across>".
#
# The rest of the fixture is small test patterns, and small is the one size the grid's thumbnails
# never had trouble with. A folder of renders off somebody's own share is the opposite: several
# megabytes each, and a PNG past a certain size gets no thumbnail at all -- see ThumbnailPolicy
# for what that size is and why it is a PNG's problem and not a JPEG's.
#
# The contents are random noise rather than a test pattern, because that is what makes the file
# large: a pattern of the same dimensions compresses down to nothing and would never reach the
# mark. The sides are chosen to sit either side of it, and seed-share.sh checks that they still do
FIXTURE_RENDERS_FOLDER="${FIXTURE_RENDERS_FOLDER:-Renders}"
FIXTURE_RENDERS=(
    "under-the-mark.png:1240"
    "over-the-mark.png:1560"
    "far-over-the-mark.png:3000"
    "over-the-mark-but-a-jpeg.jpg:5000"
    "マークをこえた.png:1560"
)

# where the mark is, and which of the renders above must land on either side of it. The number is
# Glide's Downsampler.MARK_POSITION, the same one ThumbnailPolicy.REWINDABLE_BYTES carries
FIXTURE_REWINDABLE_BYTES=$((5 * 1024 * 1024))
FIXTURE_RENDERS_UNDER_THE_MARK="under-the-mark.png"

# Folders of one video each, under Filler/, on top of the tree above.
#
# They are there to make the walk take long enough to interrupt. Rule 1 of #59 is about what a
# swipe does to a scan that is *running*, and a share of eleven files is walked faster than
# anything can be asked about it -- the first attempt at these scripts failed for exactly that
# reason, with the scan finished before the swipe landed.
FIXTURE_FILLER_FOLDERS="${FIXTURE_FILLER_FOLDERS:-2000}"

# what the counts add up to, and what a scan of the whole share must report
FIXTURE_MEDIA_FOLDERS=$((5 + FIXTURE_FILLER_FOLDERS))
FIXTURE_VIDEOS=$((7 + FIXTURE_FILLER_FOLDERS))
FIXTURE_IMAGES=$((4 + ${#FIXTURE_RENDERS[@]}))
FIXTURE_MEDIA=$((11 + ${#FIXTURE_RENDERS[@]} + FIXTURE_FILLER_FOLDERS))

# the videos are all this long, so "the right video is playing" can be told from the seek bar
FIXTURE_VIDEO_SECONDS=4

# Which folder of the share is copied off it, and which file out of it, for 50-copy-off-share.sh.
# Screens because it holds two small images: what that script is about is the path a copy travels,
# not how many bytes move
FIXTURE_COPY_SOURCE_FOLDER="${FIXTURE_COPY_SOURCE_FOLDER:-Screens}"
FIXTURE_COPY_SOURCE_FILE="${FIXTURE_COPY_SOURCE_FILE:-image-1.jpg}"

# Where such a copy lands on the device.
#
# The destination is picked out of the app's own folder list, so it has to be a folder the app
# already knows -- which means a folder MediaStore already has something in. 50-copy-off-share.sh
# seeds one image into it and asks MediaStore to take note. It does that itself rather than in
# seed-app.sh because /sdcard outlives pm clear, so the folder is set up once and reused
FIXTURE_LOCAL_DESTINATION_DIR="${FIXTURE_LOCAL_DESTINATION_DIR:-/sdcard/Pictures/Inbox}"
FIXTURE_LOCAL_DESTINATION_NAME="${FIXTURE_LOCAL_DESTINATION_NAME:-Inbox}"

# The other direction, for 70-copy-to-the-share.sh: a file of the device copied onto the share.
#
# The folder it comes from is seeded by that script for the same reason 50-copy-off-share.sh seeds
# its destination -- the picker lists what the app knows, and the app knows what MediaStore has.
# /sdcard outlives pm clear, so it is set up once and reused
FIXTURE_DEVICE_SOURCE_DIR="${FIXTURE_DEVICE_SOURCE_DIR:-/sdcard/Pictures/Outbox}"
FIXTURE_DEVICE_SOURCE_NAME="${FIXTURE_DEVICE_SOURCE_NAME:-Outbox}"
FIXTURE_DEVICE_SOURCE_FILE="${FIXTURE_DEVICE_SOURCE_FILE:-to-the-share.jpg}"

# A modification time to give that file, far enough in the past that the share's own clock could
# never produce it by accident. What the share stamps on a file it has just been handed is the
# time it arrived, so a copy that still carries this one is a copy that carried its mtime across
FIXTURE_DEVICE_SOURCE_MODIFIED="${FIXTURE_DEVICE_SOURCE_MODIFIED:-2021-03-04 05:06:07}"

# Which folder of the share it lands in. Screens again, and for the same reason it is the source
# of the other direction: two small images, so the folder has a row in the cache and can be picked
# out of the picker's list.
#
# What the script leaves there it takes away again, on its way out and on its way in. The counts
# above are what 10-scan-whole-share.sh asserts on, and a file left behind here would make that
# script fail somewhere far away from the reason
FIXTURE_SHARE_DESTINATION_FOLDER="${FIXTURE_SHARE_DESTINATION_FOLDER:-Screens}"

# What 55-delete-on-the-share.sh puts on the share so that it has something to delete again.
#
# Nothing the counts above are asserted on may be deleted, so that script brings its own: one
# file into a folder that is already there, and one folder of its own with a file in it. The
# folder has to hold a medium -- a folder of the share with nothing in it gets no row, and what
# has no row is not in the folder list to be picked.
#
# Both are taken away again on the way out and on the way in, like the copy's destination above.
# The names say what they are for, so that a run killed between the seeding and the delete leaves
# something the next reader of fixture/share can tell from the fixture at a glance
FIXTURE_DELETE_FOLDER="${FIXTURE_DELETE_FOLDER:-Screens}"
FIXTURE_DELETE_FILE="${FIXTURE_DELETE_FILE:-doomed.jpg}"
FIXTURE_DELETE_DOOMED_FOLDER="${FIXTURE_DELETE_DOOMED_FOLDER:-Doomed}"
FIXTURE_DELETE_DOOMED_FOLDER_FILE="${FIXTURE_DELETE_DOOMED_FOLDER_FILE:-inside.jpg}"

# Where the app's recycle bin is on the share: a folder of this name in the share's root, made
# by the first delete and holding what was deleted under its original layout. It is
# RECYCLE_BIN_FOLDER_NAME, the same folder the app makes on pCloud. 55-delete-on-the-share.sh
# reads what landed in it off this machine, and takes the folder away on its way out
FIXTURE_RECYCLE_BIN_FOLDER="${FIXTURE_RECYCLE_BIN_FOLDER:-.gallery-recycle-bin}"

# What 56-delete-on-the-device.sh puts on the device: a file into the folder 70 copies from,
# beside that script's own file, and a folder of its own with a file in it. A delete on the
# device goes through the app's recycle bin, which is the app's own files directory with the
# file under its full original path, so the witness is the device itself, read with run-as.
# Both are taken away again on the way out and on the way in; the app's data is wiped by
# seed-app.sh, and the bin with it
FIXTURE_DEVICE_DELETE_FILE="${FIXTURE_DEVICE_DELETE_FILE:-doomed-on-the-device.jpg}"
FIXTURE_DEVICE_DELETE_FOLDER="${FIXTURE_DEVICE_DELETE_FOLDER:-DoomedOnTheDevice}"
FIXTURE_DEVICE_DELETE_FOLDER_FILE="${FIXTURE_DEVICE_DELETE_FOLDER_FILE:-inside.jpg}"

# What 65-rename-on-the-share.sh puts on the share, for the same reason the delete does: the
# counts above are asserted on elsewhere, so it brings its own file and its own folder and takes
# them away again on the way in and on the way out.
#
# None of these names holds a space, and that is not an oversight: `adb shell input text` cannot
# type one. A folder called "Trips 2026" is where the prefix matching gets interesting, and that
# half is asked about in RenamedPathsTest instead, where no keyboard is in the way
FIXTURE_RENAME_FOLDER="${FIXTURE_RENAME_FOLDER:-Screens}"
FIXTURE_RENAME_FILE="${FIXTURE_RENAME_FILE:-before-the-rename.jpg}"
FIXTURE_RENAME_NEW_FILE="${FIXTURE_RENAME_NEW_FILE:-after-the-rename.jpg}"
FIXTURE_RENAME_DIR="${FIXTURE_RENAME_DIR:-Renameable}"
FIXTURE_RENAME_NEW_DIR="${FIXTURE_RENAME_NEW_DIR:-Renamed}"
FIXTURE_RENAME_DIR_FILE="${FIXTURE_RENAME_DIR_FILE:-inside.jpg}"

# What 85-overwrite-on-the-share.sh puts on the share, for the same reason the rename does: the
# counts above are asserted on elsewhere, so it brings its own file and takes it away again on
# the way in and on the way out.
#
# It is written over by a "Save as" that keeps the name the medium already has -- the dialog opens
# with that name filled in, so the plainest thing anybody can do in it is the case under test
FIXTURE_OVERWRITE_FOLDER="${FIXTURE_OVERWRITE_FOLDER:-Screens}"
FIXTURE_OVERWRITE_FILE="${FIXTURE_OVERWRITE_FILE:-to-be-written-over.jpg}"

# What the app calls the original while the new content is going up, and what nothing may be left
# under once the write is through. It is SmbWriter.STASH_SUFFIX, and the one thing a half-done
# overwrite leaves behind that a reader of fixture/share could not otherwise explain
FIXTURE_OVERWRITE_STASH_SUFFIX="${FIXTURE_OVERWRITE_STASH_SUFFIX:-being-replaced}"

# What 97-edit-on-the-share.sh puts on the share, for the same reason the overwrite does: it
# brings its own file and takes it away again on the way in and on the way out.
#
# The editor is handed a copy of this in the app's own cache rather than the medium itself -- a
# path of the share is not a path this device has, and an editor given one opens on nothing. What
# it writes goes back over the medium through the same stash and replace the overwrite uses, so
# the stash suffix above is what nothing may be left under here either
FIXTURE_EDIT_FOLDER="${FIXTURE_EDIT_FOLDER:-Screens}"
FIXTURE_EDIT_FILE="${FIXTURE_EDIT_FILE:-to-be-edited.jpg}"

# What 47-hand-out-a-medium-of-the-share.sh puts on the share, for the same reason the edit
# does: it brings its own file and takes it away again on the way in and on the way out. It is
# handed to other apps, set as the wallpaper, asked for its place on the map, printed, and
# resized -- the last of which writes it back over itself, which is why it cannot be one of the
# files the counts are about
FIXTURE_HANDOUT_FOLDER="${FIXTURE_HANDOUT_FOLDER:-Screens}"
FIXTURE_HANDOUT_FILE="${FIXTURE_HANDOUT_FILE:-to-be-handed-out.jpg}"

# Where the app keeps the links it hands other apps, under its own cache directory: one
# directory per cached copy, holding the medium under its own name, so that whatever receives
# it shows the name the medium has on the share. It is SMB_WORK_DIR
FIXTURE_SMB_WORK_DIR="${FIXTURE_SMB_WORK_DIR:-cache/smb-work}"

# Where the app keeps its copies of the media of the share, under its own cache directory. The
# copy is named "<hash>-<size>-<modified>", so the listing of this directory says what the rows
# hold without a database being opened -- which is how a write over a medium is checked to have
# moved the row on and not only the bytes. It is SMB_CACHE_DIR
FIXTURE_SMB_CACHE_DIR="${FIXTURE_SMB_CACHE_DIR:-cache/smb}"

# What 95-move-on-the-share.sh puts on the share: two media of its own, for the two moves that
# have the share on the source side. One is moved to another folder of the share, the other off
# the share onto this device. Both are taken away again on the way in and on the way out, like
# every other script that writes to the fixture.
#
# The destination on the share is a folder the fixture already has, so that the picker lists it:
# the copy/move picker offers the folders the scan found, not a walk of the share
FIXTURE_MOVE_FOLDER="${FIXTURE_MOVE_FOLDER:-Screens}"
FIXTURE_MOVE_FILE="${FIXTURE_MOVE_FILE:-to-be-moved.jpg}"
FIXTURE_MOVE_AWAY_FILE="${FIXTURE_MOVE_AWAY_FILE:-to-be-moved-away.jpg}"
FIXTURE_MOVE_DESTINATION="${FIXTURE_MOVE_DESTINATION:-Camera}"

# And the third direction: a file of the device moved onto the share. It is seeded into the same
# folder 70-copy-to-the-share.sh copies out of, under a name of its own, so that a run of one
# cannot be read as a leftover of the other
FIXTURE_MOVE_ONTO_FILE="${FIXTURE_MOVE_ONTO_FILE:-to-be-moved-onto.jpg}"

# The groups the fixture starts with, for #64. Group 1 holds a folder and group 2; group 2 holds
# the other folder. That is the one shape worth having: a subgroup has to be walked where it sits
# in the list, not after the plain folders
FIXTURE_GROUP_PARENT_ID=1
FIXTURE_GROUP_PARENT_NAME="Trips"
FIXTURE_GROUP_CHILD_ID=2
FIXTURE_GROUP_CHILD_NAME="Kyoto"

# Which storage a script drives to once the app is up, and which scans the settings are allowed
# to start. The folder list always opens on this device, so this is not a preference to seed any
# more: app_start reaches the storage through the chip, the way the user reaches it.
# The driving scripts override these: rule 1-a of #59 needs a scan the settings started (which
# ranks below a storage switch), and every other script needs the settings to start nothing at all
FIXTURE_STORAGE_FILTER="${FIXTURE_STORAGE_FILTER:-4}"   # 4 = the network share, 1 = this device
FIXTURE_RESCAN_ON_LAUNCH="${FIXTURE_RESCAN_ON_LAUNCH:-false}"
FIXTURE_RESCAN_ON_STORAGE_SWITCH="${FIXTURE_RESCAN_ON_STORAGE_SWITCH:-false}"
FIXTURE_RESCAN_ON_PULL_TO_REFRESH="${FIXTURE_RESCAN_ON_PULL_TO_REFRESH:-false}"

# The folder list's sorting. 1 is SORT_BY_NAME ascending, taken from the commons constants.
# It is pinned rather than left at the default (date modified, descending) because the order the
# download queue walks in is the order the list draws in: with names, "Kyoto" the subgroup sorts
# before "Osaka" the folder, and #64's rule -- a subgroup is walked where it sits -- becomes
# something a script can assert on
FIXTURE_DIRECTORY_SORT="${FIXTURE_DIRECTORY_SORT:-1}"

# The pCloud stub, for 60-copy-to-pcloud.sh.
#
# There is no pCloud account behind these scripts and there is not meant to be one: a throwaway
# account would put a token somewhere outside this repository, make every run depend on a network,
# and drift between runs. fixture/pcloud-stub.py answers the slice of the API the app calls,
# backed by a directory here, so what arrived can be looked at with plain `stat`
FIXTURE_PCLOUD_DIR="${FIXTURE_PCLOUD_DIR:-$FIXTURE_DIR/pcloud}"
FIXTURE_PCLOUD_PORT="${FIXTURE_PCLOUD_PORT:-8089}"
FIXTURE_PCLOUD_TOKEN="${FIXTURE_PCLOUD_TOKEN:-fixture-token}"

# how the app reaches it: 10.0.2.2 is this machine as seen from inside the emulator, and the
# scheme is part of it -- see pCloudUrl(), and the debug build's network config for why plain http
# is allowed to this one host and to nothing else
FIXTURE_PCLOUD_STUB_API_HOST="${FIXTURE_PCLOUD_STUB_API_HOST:-http://10.0.2.2:$FIXTURE_PCLOUD_PORT}"

# The folder in that account a copy is sent to, and the image seeded into it so that it exists at
# all: a pCloud folder with nothing in it is no destination, the picker lists what the scan found
FIXTURE_PCLOUD_DESTINATION_NAME="${FIXTURE_PCLOUD_DESTINATION_NAME:-Uploads}"

# What seed-app.sh writes into the app as its pCloud account. Empty by default -- every other
# script wants an app that is signed out, and an app that is signed out asks the stub nothing.
# 60-copy-to-pcloud.sh passes the two of them in, which is the whole of "signing in": the token
# is what the OAuth screen would have stored, and nothing else about that screen is under test
FIXTURE_PCLOUD_ACCESS_TOKEN="${FIXTURE_PCLOUD_ACCESS_TOKEN:-}"
FIXTURE_PCLOUD_API_HOST="${FIXTURE_PCLOUD_API_HOST:-}"
